{
  "name": "benefit-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run build:toss",
    "build:web": "next build --webpack",
    "build:toss": "npm run export:toss && ait build",
    "export:toss": "TOSS_BUILD=true NEXT_PUBLIC_TOSS_BUILD=true next build --webpack",
    "start": "next start",
    "fetch:policies": "node --env-file=.env.local scripts/fetchPolicies.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apps-in-toss/cli": "^3.7.0",
    "@apps-in-toss/web-framework": "^3.7.0",
    "lucide-react": "^0.577.0",
    "next": "^16.4.0",
    "next-view-transitions": "^0.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
